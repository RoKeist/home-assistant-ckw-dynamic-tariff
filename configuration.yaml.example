# Example CKW dynamic tariff REST sensor for Home Assistant.
# Merge this into your existing configuration.yaml; do not add a second
# top-level `rest:` key if you already have one.
rest:
  - resource: https://e-ckw-public-data.de-c1.eu1.cloudhub.io/api/v1/netzinformationen/energie/dynamische-preise
    scan_interval: 21600
    params:
      # Use home_dynamic for annual consumption below 50 MWh;
      # use business_dynamic above 50 MWh.
      tariff_name: home_dynamic
      # Available examples: integrated, grid, grid_usage, electricity.
      tariff_type: integrated
      # Request today and tomorrow using Home Assistant's configured timezone.
      start_timestamp: "{{ today_at('00:00').isoformat() }}"
      end_timestamp: "{{ (today_at('00:00') + timedelta(days=2)).isoformat() }}"
    sensor:
      - name: "CKW Tariff Data"
        unique_id: ckw_tariff_data
        value_template: "OK"
        json_attributes:
          - publication_timestamp
          - prices
